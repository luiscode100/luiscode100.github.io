---
import GitHub from "../icons/GitHub.astro"
import Link from "../icons/Link.astro"
import LinkButton from "../ui/LinkButton.astro"
import { PROJECTS } from "@/data/projects"
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="group flex flex-col space-x-0 space-y-8 md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="block cursor-pointer"
          >
            <div class="relative flex flex-col items-center gap-8 overflow-clip rounded-xl shadow-xl transition duration-500 ease-in-out transform sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
              <img
                alt={title}
                class="h-56 w-full object-cover object-top transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            </div>
          </a>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer transition-colors duration-200 hover:text-cyan-400"
          >
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
              {title}
            </h3>
          </a>
          <div class="mt-2 flex flex-wrap">
            <ul class="mb-1 flex flex-row gap-x-1">
              {tags.map((tag) => (
                <li>
                  <span class={`flex gap-x-2 rounded-full px-2 py-1 text-xs ${tag.class}`}>
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
            <footer class="mt-4 flex items-end justify-start gap-x-4">
              <LinkButton href={github}>
                <GitHub class="size-6" />
                Code
              </LinkButton>
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
