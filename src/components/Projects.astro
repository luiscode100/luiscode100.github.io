---
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  REACT: {
    name: "React.js",
    class: "bg-black text-white",
  },
  REACT_ROUTER: {
    name: "React Router.js",
    class: "bg-black text-white",
  },
  JAVASCRIPT: {
    name: "Javascript.js",
    class: "bg-black text-white",
  },
  VITE: {
    name: "Vite.js",
    class: "bg-black text-white",
  },
  EXPRESS: {
    name: "Express.js",
    class: "bg-black text-white",
  },
  POSTGRESQL: {
    name: "PostgreSQL.js",
    class: "bg-black text-white",
  },
  NODE: {
    name: "Node.js",
    class: "bg-black text-white",
  },
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
  },
  TAILWIND: {
    name: "Tailwind",
    class: "bg-black  text-white",
  },
  JWT: {
    name: "JWT",
    class: "bg-black text-white",
  },
  BCRYPT: {
    name: "bcrypt",
    class: "bg-black text-white",
  },
  HELMET: {
    name: "Helmet",
    class: "bg-black text-white",
  },
  CORS: {
    name: "CORS",
    class: "bg-black text-white",
  },
  SWAGGER: {
    name: "Swagger",
    class: "bg-black text-white",
  },
  PYTHON: {
    name: "Python",
    class: "bg-black text-white",
  },
  LAMBDA: {
    name: "Lambda",
    class: "bg-black text-white",
  },
  SQS: {
    name: "SQS",
    class: "bg-black text-white",
  },
  SNS: {
    name: "SNS",
    class: "bg-black text-white",
  },
  S3: {
    name: "S3",
    class: "bg-black text-white",
  },
  RDS: {
    name: "RDS",
    class: "bg-black text-white",
  },
  VPC: {
    name: "VPC",
    class: "bg-black text-white",
  },
  DYNAMO: {
    name: "DynamoDB",
    class: "bg-black text-white",
  },
  API: {
    name: "API",
    class: "bg-black text-white",
  },
  TERRAFORM: {
    name: "Terraform",
    class: "bg-black text-white",
  },
};

const PROJECTS = [
  {
    title: "Tasklist – Aplicación web para gestión de tareas",
    description:
      "Desarrollo de una aplicación web para la gestión y organización de tareas, permitiendo a los usuarios crear, actualizar y administrar sus tareas desde una interfaz sencilla e intuitiva. El proyecto implementa autenticación de usuarios y una arquitectura frontend y backend separada y despliegue en producción.",
    link: "https://tasklist-gamma-nine.vercel.app",
    github: "https://github.com/luiscode100/tasklist",
    image: "/projects/tasklist.webp",
    tags: [
      TAGS.VITE,
      TAGS.TAILWIND,
      TAGS.REACT,
      TAGS.NODE,
      TAGS.JWT,
      TAGS.POSTGRESQL,
    ],
  },
  {
    title: "aws-claims-management – API serverless para gestión de siniestros",
    description:
      "Desarrollo de una plataforma escalable para el procesamiento de siniestros mediante una arquitectura de microservicios. El sistema utiliza colas SQS para gestionar el procesamiento de los siniestros y automatiza el cálculo de costes y la generación de informes en PDF.",
    github: "https://github.com/luiscode100/aws-claims-management",
    image: "/projects/claims.webp",
    tags: [TAGS.PYTHON, TAGS.VPC, TAGS.RDS, TAGS.LAMBDA, TAGS.SQS, TAGS.SNS],
  },
  {
    title: "FaceDetect – API serverless para detección de rostros",
    description:
      "Aplicación en la nube que identifica rostros en imágenes enviadas por los usuarios. Al subir una imagen, el sistema analiza las caras y guarda los resultados. Todo el proceso se ejecuta en AWS sin servidores.",
    github: "https://github.com/luiscode100/aws-face-detection",
    image: "/projects/detect_faces.webp",
    tags: [TAGS.PYTHON, TAGS.LAMBDA, TAGS.DYNAMO, TAGS.S3, TAGS.API],
  },
  {
    title:
      "AWS AutoScaling Web Cluster – Despliegue automatizado con Terraform",
    description:
      "Infraestructura web en AWS desplegada con Terraform. El sistema crea, configura y escala instancias EC2 según la carga mediante un balanceador de aplicación y autoescalado.",
    github:
      "https://github.com/luiscode100/terraform-aws-autoscaling-web-cluster",
    image: "/projects/aws_autoscaling.webp",
    tags: [TAGS.TERRAFORM],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer block"
          >
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
              <img
                alt="Recién llegado vs 5 años en Nueva Zelanda"
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            </div>
          </a>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cyan-400 transition-colors duration-200 cursor-pointer"
          >
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
              {title}
            </h3>
          </a>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-1 gap-x-1">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    {/* <tag.icon class="size-4" /> iconos*/}
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
