---
const navItems = [
  {
    title: "Inicio",
    label: "inicio",
    url: "/#home",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "/#contacto",
  },
];
---

<header
  class="fixed top-0 z-50 flex items-center justify-center w-full mx-auto mt-2 px-4"
>
  <nav
    class="relative flex items-center justify-between rounded-full border border-white/10 bg-white/50 px-3 py-2 text-sm font-medium text-gray-600 shadow-lg backdrop-blur-md dark:bg-gray-800/90 dark:text-gray-200"
  >
    <div id="nav-links" class="hidden items-center gap-6 md:flex">
      {
        navItems.map((link) => (
          <a
            class="relative block rounded-full px-2 py-2 transition hover:text-blue-500 dark:hover:text-blue-500"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>

    <button
      id="mobile-menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="inline-flex items-center justify-center rounded-full p-2 text-gray-700 transition hover:text-blue-500 dark:text-gray-200 md:hidden"
    >
      <svg
        id="menu-icon"
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="fixed inset-x-4 top-16 z-40 hidden rounded-2xl border border-white/10 bg-white/80 p-3 shadow-lg backdrop-blur-md dark:bg-gray-900/90 md:hidden"
>
  <div class="flex flex-col gap-1">
    {
      navItems.map((link) => (
        <a
          class="rounded-xl px-3 py-2 text-sm text-gray-700 transition hover:bg-blue-500/10 hover:text-blue-500 dark:text-gray-200"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a, #mobile-menu a");
    const mobileMenuButton = document.querySelector("#mobile-menu-button");
    const mobileMenu = document.querySelector("#mobile-menu");

    const toggleMobileMenu = () => {
      const isOpen = mobileMenu?.classList.toggle("hidden");
      const expanded = !mobileMenu?.classList.contains("hidden");
      if (mobileMenuButton) {
        mobileMenuButton.setAttribute("aria-expanded", String(expanded));
      }
      if (mobileMenuButton && expanded) {
        mobileMenuButton.setAttribute("aria-label", "Cerrar menú");
      } else if (mobileMenuButton) {
        mobileMenuButton.setAttribute("aria-label", "Abrir menú");
      }
    };

    mobileMenuButton?.addEventListener("click", toggleMobileMenu);

    mobileMenu?.querySelectorAll("a").forEach((item) => {
      item.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        if (mobileMenuButton) {
          mobileMenuButton.setAttribute("aria-expanded", "false");
          mobileMenuButton.setAttribute("aria-label", "Abrir menú");
        }
      });
    });

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-blue-500");
            } else {
              item.classList.remove("text-blue-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    0% {
      @apply dark:bg-gray-800/0 bg-white/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
